
import 'package:flutter/cupertino.dart';
import 'package:flutter/material.dart';

void main(){
  runApp(MainScreen());
}
class MainScreen extends StatefulWidget{
  _MainScreen createState() => _MainScreen();
}
class _MainScreen extends State<MainScreen>{
  var onTap=false;
  Widget build(BuildContext context){
    return MaterialApp(home: Scaffold(
      body: Center(child:Column(mainAxisAlignment: MainAxisAlignment.center,crossAxisAlignment:CrossAxisAlignment.center,children: [AnimatedOpacity(opacity:onTap ? 1.0 : 0.0, duration:(Duration(milliseconds:400)),child:Text("hello flutter")),ElevatedButton(onPressed:(){
        setState(() {
          onTap=!onTap;
        });
      }, child:Text("click to change"))])),
    ));
  }
}
